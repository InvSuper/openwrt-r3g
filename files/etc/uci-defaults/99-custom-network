#!/bin/sh
# uci-defaults 机制：此脚本仅在固件首次启动时执行一次，成功后自动删除
#
# 目的：把 LAN 管理 IP 从默认的 192.168.1.1 改为 192.168.0.4
# 原因：本机是小米路由器（做纯二层 VLAN 交换机），需并入主路由
#       ZN M2 所在的 192.168.0.0/24 网段；改完后刷机首次开机
#       即可直接通过 192.168.0.4 访问，无需单独用电脑直连配置
# 注意：固件已删除 dnsmasq，本机不提供 DHCP 服务，
#       下级设备的 IP 分配仍由主路由 192.168.0.1 负责
uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.0.4'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.0.1'
set network.lan.dns='192.168.0.1'
commit network
EOF
exit 0
